# Whapi.cloud
WHAPI_TOKEN=
WHAPI_BASE_URL=https://gate.whapi.cloud

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Webhook auth (generate a long random string)
# Prefer header: x-bot-webhook-secret
# Fallback query: ?secret=
WEBHOOK_SECRET=

# Admin WhatsApp for meat quotes (Mexico mobile JID). Papá.
ADMIN_PHONE=5213312974282@s.whatsapp.net

# Intermediación de ganado. Si se omite, usa 5213310184790.
INTERMEDIARIO_PHONE=5213310184790

# Pedidos de la forrajera. Si se omite, usa ADMIN_PHONE.
FORRAJERA_PEDIDOS_PHONE=

# Optional
MAX_HISTORY=24

# Supabase (schema obrador). Si faltan, el bot sigue en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Avisos masivos. Apagados si no es exactamente true.
BROADCASTS_ENABLED=false
REMINDERS_ENABLED=false

# Semana 1 por defecto: 15/hora y 50/día. No sube solo.
BROADCAST_WEEK=1
BROADCAST_PER_HOUR=15
BROADCAST_PER_DAY=50
BROADCAST_PER_PERSON_DAY=1
BROADCAST_PER_PERSON_WEEK=3
BROADCAST_PAUSE_MIN_SEC=30
BROADCAST_PAUSE_MAX_SEC=90
BROADCAST_LONG_EVERY=20
BROADCAST_LONG_MIN_SEC=300
BROADCAST_LONG_MAX_SEC=600
BROADCAST_START_HOUR=9
BROADCAST_END_HOUR=19
BROADCAST_SUMMARY_IF_OVER=3
BROADCAST_COOLDOWN_AFTER=3
BROADCAST_DROP_AFTER=6
BROADCAST_MAX_FAIL_STREAK=3
BROADCAST_MAX_FAIL_RATE=0.05
BROADCAST_MAX_OPTOUT_RATE=0.05
BROADCAST_HOLIDAYS=

# Endpoints de promos y crons. Sin valor, responden 401.
ADMIN_API_TOKEN=
CRON_SECRET=
